# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used ONLY in server actions (never exposed to browser).
# Required for the "Delete Account" feature (hard-deletes auth.users record).
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# ⚠️  Keep this secret. Never expose it in client code or NEXT_PUBLIC_ vars.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL ───────────────────────────────────────────────────────────────────
# Used in OAuth redirects and password-reset emails.
# In development this is usually http://localhost:3000
# In production set it to your deployed URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
